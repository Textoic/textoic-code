        "no-noun-clusters": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "off",
                "hint",
                "info",
                "warn",
                "error"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": [
                {
                  "type": "string",
                  "enum": [
                    "off",
                    "hint",
                    "info",
                    "warn",
                    "error"
                  ]
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              ]
            }
          ]
        },
        "no-passive-sentences": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "off",
                "hint",
                "info",
                "warn",
                "error"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": [
                {
                  "type": "string",
                  "enum": [
                    "off",
                    "hint",
                    "info",
                    "warn",
                    "error"
                  ]
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              ]
            }
          ]
        },
        "no-similes": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "off",
                "hint",
                "info",
                "warn",
                "error"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": [
                {
                  "type": "string",
                  "enum": [
                    "off",
                    "hint",
                    "info",
                    "warn",
                    "error"
                  ]
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              ]
            }
          ]
        },
        "no-special-punctuation": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "off",
                "hint",
                "info",
                "warn",
                "error"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": [
                {
                  "type": "string",
                  "enum": [
                    "off",
                    "hint",
                    "info",
                    "warn",
                    "error"
                  ]
                },
                {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              ]
            }
          ]
        }
      }
    }
  }
}